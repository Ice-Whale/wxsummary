# ===== 微信群聊日报配置 =====
# 复制为 .env 后填写：cp .env.example .env

# chatlog-keeper 导出的 JSON 路径（留空用默认位置；改成你自己的导出文件路径）
EXPORT_JSON=/path/to/chatlog-keeper/export/wechat_messages.json

# 生成日报前自动导出最近多少天的微信数据（0=跳过自动导出，只读已有 JSON）
EXPORT_DAYS=7

# DeepSeek API Key（去你的 API 平台申请，如 paratera / 智谱）
ZHIPUAI_API_KEY=

# 模型名（paratera 平台用 DeepSeek-V4-Flash-0731）
ZHIPUAI_MODEL=DeepSeek-V4-Flash-0731

# OpenAI 兼容接口的 base_url
# paratera 平台：https://ai.paratera.com/v1
# 智谱官方：https://open.bigmodel.cn/api/paas/v4
AI_API_BASE=https://ai.paratera.com/v1